#!/bin/bash
set -euo pipefail
# cron에는 PATH, KUBECONFIG가 없다
export PATH=/usr/local/bin:/usr/bin:/bin
export KUBECONFIG={{ kubeconfig_path }}
REGISTRY="{{ pretix_image.split('/')[0] }}"
TOKEN=$(aws ecr get-login-password --region {{ aws_region }} --profile {{ ecr_profile }})
kubectl create secret docker-registry ecr-pull -n pretix \
  --docker-server="$REGISTRY" --docker-username=AWS --docker-password="$TOKEN" \
  --dry-run=client -o yaml | kubectl apply -f -
echo "ecr-pull secret refreshed: $(date)"
