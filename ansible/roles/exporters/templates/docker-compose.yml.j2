# node_exporter는 systemd로 돈다. 컨테이너로도 띄우면 9100 충돌
services:
  cadvisor:
    image: ghcr.io/google/cadvisor:{{ cadvisor_version }}
    container_name: cadvisor
    privileged: true
    devices:
      - /dev/kmsg:/dev/kmsg
    ports:
      - "10.10.0.2:8081:8080"
    volumes:
      - '/:/rootfs:ro'
      - '/var/run:/var/run:ro'
      - '/sys:/sys:ro'
      - '/var/lib/docker:/var/lib/docker:ro'
      - '/dev/disk:/dev/disk:ro'
    restart: unless-stopped
