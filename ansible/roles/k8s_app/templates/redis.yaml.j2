apiVersion: apps/v1
kind: Deployment
metadata:
  name: redis
  namespace: pretix
spec:
  replicas: 1
  selector:
    matchLabels: { app: redis }
  template:
    metadata:
      labels: { app: redis }
    spec:
      enableServiceLinks: false   # PRETIX_* 환경변수 충돌 방지
      containers:
        - name: redis
          image: redis:7
          ports:
            - containerPort: 6379
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: pretix
spec:
  selector: { app: redis }
  ports:
    - port: 6379
